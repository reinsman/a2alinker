#!/bin/bash
# 为 pi 单独初始化 nvm，不依赖启动 a2alinker 的终端是否执行过 nvm use。
# 不启用 set -u/-e：nvm 脚本有自己的错误处理，下面逐步检查返回值。

if [ -z "${NVM_DIR:-}" ]; then
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then
        export NVM_DIR="$XDG_CONFIG_HOME/nvm"
    else
        export NVM_DIR="$HOME/.nvm"
    fi
fi

node_version="${A2ALINKER_NODE_VERSION:-24.20.0}"
if [ ! -r "$NVM_DIR/nvm.sh" ]; then
    printf '无法读取 %s/nvm.sh，请在 agent.env 中设置 NVM_DIR。\n' "$NVM_DIR" >&2
    exit 127
fi

# stdout 专用于 pi 的 JSONL 协议；初始化、版本切换的输出全部送到 stderr。
if ! . "$NVM_DIR/nvm.sh" --no-use >&2; then
    printf '初始化 nvm 失败。\n' >&2
    exit 127
fi
if ! nvm use --silent "$node_version" >&2; then
    printf '无法选择 Node.js %s，请先手动执行 nvm install %s。\n' "$node_version" "$node_version" >&2
    exit 127
fi

# 只使用选定版本下的 pi，不意外回退到 PATH 中另一套 Node.js 的全局安装。
if [ -z "${NVM_BIN:-}" ] || [ ! -x "$NVM_BIN/pi" ]; then
    printf 'Node.js %s 下未安装 pi，请切换该版本后执行 npm install -g @earendil-works/pi-coding-agent。\n' "$node_version" >&2
    exit 127
fi

# exec 保留原参数、stdin/stdout 和进程组，使网关的取消与清理机制继续生效。
exec "$NVM_BIN/pi" "$@"
